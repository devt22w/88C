# Copy this file to `.env` and paste your Supabase project credentials.
# Both values are safe to ship in the browser bundle *because* row level
# security is on and the anon role can only read. See supabase/schema.sql.
#
# Project settings → API in the Supabase dashboard.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ⚠️ NEVER put the service_role key in a VITE_ variable. Anything prefixed with
# VITE_ is compiled into the JavaScript every visitor downloads. The service
# role bypasses row level security — keep it on the server or in the dashboard.
